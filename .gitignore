# Archivos de entorno y configuración
.env

# Archivos y carpetas de IDE/Editor
.idea/
.vscode/

# Archivos generados por Python
__pycache__/
*.pyc

# Archivos de modelos
resources/*/*.pkl

# Bases de datos locales
db.sqlite3
neo4j_db/
mongo_db/

# Archivos de logs
centinela_logs/debug.log
*.log
centinela_logs/*.log*

# Entorno virtual
venv/
.venv-ragas/

# Resultados de evaluación: se versionan summary.md y csv; json detallados quedan locales
ragas_results/**/*.json
!ragas_results/**/.gitkeep
!ragas_results/.gitkeep
!ragas_results/recall/.gitkeep
!ragas_results/recall_compare/.gitkeep
!ragas_results/latency/.gitkeep

# Caché de modelos y variables de entorno locales
hf_cache/
.env_produccion
.env*

# Agent configuration (local only, not committed)
AGENTS.md
.claude/

# Artefactos de tests locales
.coverage
coverage-*.xml
report*.xml
htmlcov/
.venv-test/
.venv-test-requirements.txt
seed_data/backup.json
seed_data/centinela_db/*
